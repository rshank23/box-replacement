# Base URL of the Integration API. Leave empty to use the dev proxy / nginx reverse proxy.
VITE_API_BASE_URL=

# Target used by the Vite dev-server proxy for /api and /health.
VITE_API_PROXY_TARGET=http://localhost:8080

# Enterprise SSO entry point. The "Sign in via SSO" button navigates here.
VITE_SSO_LOGIN_URL=

# Shown in the UI header so operators always know which environment they are in.
VITE_ENVIRONMENT_LABEL=Local development
