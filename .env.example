# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
DB_DSN=postgresql+psycopg2://app:app@localhost:5432/mbox_vtmf

# --- MBox source ------------------------------------------------------------
MBOX_ROOT=./demo/mbox
MBOX_POLL_ISO_DURATION=PT30M
MIN_FOLDER_DEPTH=3
ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.zip
MAX_FILE_MB=500
# -1 = extract nested archives at every level
ZIP_MAX_DEPTH=-1
FOLDER_AGE_WARN_DAYS=60
FOLDER_AGE_CRITICAL_DAYS=75
FOLDER_RETENTION_DAYS=90

# --- Veeva Vault TMF --------------------------------------------------------
# fake = local in-memory stub, real = live Vault REST API
VAULT_CLIENT=fake
VAULT_BASE_URL=https://myvault.veevavault.com
VAULT_API_VERSION=v26.2

# token = API access token (recommended by Veeva), password = user name + password session
VAULT_AUTH_MODE=password
# Access token value, begins with "veeva-vault-". Only visible once at creation.
VAULT_API_TOKEN=
VAULT_USERNAME=
VAULT_PASSWORD=

# Guards against Vault "authentication defaulting" landing on the wrong Vault when
# the intended one is inactive. Leave blank to skip the check (not recommended).
VAULT_EXPECTED_VAULT_ID=
VAULT_SESSION_IDLE_KEEP_ALIVE_S=1800

# Post-study archival is a migration: bypasses entry criteria/actions and notifications.
# Requires the Document Migration permission.
VAULT_MIGRATION_MODE=false
VAULT_NO_TRIGGERS=false

# Files above 50MB go through a resumable upload session; parts must be 5-52MB.
VAULT_FILE_PART_MB=25
VAULT_JOB_TIMEOUT_S=1800

DOCUMENT_LIFECYCLE=TMF Document Lifecycle
LARGE_FILE_MB=50
RATE_LIMIT_PER_SEC=5
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_S=30,120,600
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_S=60

# --- Batch behaviour --------------------------------------------------------
# Picklists are prefetched once per batch and reused until this TTL expires
PICKLIST_CACHE_TTL_S=3600
# queue = hold unmapped files for a human; unclassified = also file them in VTMF
UNMAPPED_POLICY=queue
UNCLASSIFIED_DOCUMENT_TYPE=Unclassified
UNCLASSIFIED_DOCUMENT_SUBTYPE=Unclassified
UNCLASSIFIED_CLASSIFICATION=Unclassified
# Vault pairs the Unclassified document type with the Inbox lifecycle
UNCLASSIFIED_LIFECYCLE=Inbox

# --- Batch summary digest ---------------------------------------------------
MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Credentials are refused over an unencrypted connection
SMTP_USE_TLS=true
MAIL_FROM=mbox-vtmf@example.com
# Comma separated
MAIL_TO=
MAIL_SUBJECT_PREFIX=[MBox->VTMF]

# --- Integration API (used by the watcher to submit files) ------------------
INTEGRATION_API_BASE_URL=http://localhost:8080
API_HOST=0.0.0.0
API_PORT=8080

# --- Identity / security ----------------------------------------------------
SERVICE_ACCOUNT_ID=svc-mbox
# Dev-only signing key, minimum 32 bytes. In production inject from the secret store.
JWT_SECRET=change-me-in-every-environment-min-32-bytes
JWT_ALGORITHM=HS256
JWT_AUDIENCE=mbox-vtmf
AUTH_ENABLED=true
ADMIN_ROLE=tmf_admin
CORS_ALLOW_ORIGINS=
# Local development only - never enable in a validated environment
DEV_TOKEN_ENABLED=false

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
